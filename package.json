{
  "name": "pdvl-mock-assessment",
  "description": "Deterministic, seeded mock assessments for Singapore PDVL (Modules 1, 2, 3B, 4B). Timed and shareable by URL.",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "version": "node scripts/generate-changelog.mjs && prettier --write CHANGELOG.md && git add CHANGELOG.md",
    "lint": "biome check . && prettier --check \"**/*.{md,yml,yaml}\"",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,yml,yaml}\"",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "smoke:production": "node scripts/production-smoke.cjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@swc/core": "^1.16.2",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
